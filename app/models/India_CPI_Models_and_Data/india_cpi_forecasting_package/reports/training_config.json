{
  "task": "direct monthly forecast of All-India headline CPI YoY",
  "target_source": "MoSPI December 2025 CPI release Annexure VII; Dec 2025 final cross-check against February 2026 release",
  "target_cutoff": "2025-12",
  "panel_calendar_end": "2025-12",
  "forecast_origin": "last observed month s, target is s+h; issue month is s+1",
  "backtest_issue_start": "2018-01",
  "horizons_months": [
    1,
    3,
    6
  ],
  "rolling_origin": "monthly expanding window; no future-target labels in training",
  "minimum_training_samples": 36,
  "minimum_arima_observations": 36,
  "prototype_thresholds": {
    "minimum_forecasts_per_model_horizon": 60,
    "minimum_series_coverage": 1.0,
    "minimum_mae_skill_vs_persistence": 0.0,
    "status": "internal prototype gates, not regulatory or production standards"
  },
  "features": [
    "headline_yoy_lag_0",
    "headline_yoy_lag_1",
    "headline_yoy_lag_2",
    "headline_yoy_lag_3",
    "headline_yoy_lag_6",
    "headline_yoy_lag_12",
    "headline_yoy_trailing_mean_3",
    "headline_yoy_trailing_mean_6",
    "headline_yoy_trailing_mean_12",
    "headline_yoy_change_1m",
    "headline_yoy_trailing_std_6",
    "combined_food_yoy",
    "combined_fuel_yoy",
    "combined_housing_yoy",
    "combined_transport_yoy",
    "combined_clothing_yoy",
    "rural_general_archive_yoy",
    "urban_general_archive_yoy",
    "month_sin",
    "month_cos"
  ],
  "ridge": {
    "alpha": 8.0,
    "imputer": "median + missingness indicators",
    "scaler": "StandardScaler"
  },
  "xgboost": {
    "n_estimators": 100,
    "max_depth": 2,
    "learning_rate": 0.04,
    "min_child_weight": 3,
    "subsample": 0.85,
    "colsample_bytree": 0.85,
    "reg_lambda": 8.0,
    "tree_method": "hist",
    "random_state": 2026
  },
  "arima": {
    "order": [
      1,
      0,
      0
    ],
    "trend": "c",
    "missing_values": "statsmodels state-space handling"
  },
  "versions": {
    "python": "3.12.3",
    "pandas": "3.0.6",
    "numpy": "2.5.3",
    "scikit_learn": "1.9.1",
    "statsmodels": "0.15.0",
    "xgboost": "3.4.1"
  },
  "fit_counts": {
    "Ridge": {
      "1": 142,
      "3": 142,
      "6": 142
    },
    "XGBoost": {
      "1": 142,
      "3": 142,
      "6": 142
    }
  },
  "fit_skips": {
    "arima_failures": 0,
    "ridge_skips": 0,
    "xgboost_skips": 0
  }
}
